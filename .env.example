BOT=            # Telegram bot token
SUBAPIKEY=      # Groq API key used by the agent model
DATABASE_URL=   # Postgres connection string (required by `prisma generate`)
REDIS_URL=      # Redis connection string, used for the per-chat rate limit
TELEGRAM_WEBHOOK_SECRET=  # Shared secret sent back by Telegram in X-Telegram-Bot-Api-Secret-Token
